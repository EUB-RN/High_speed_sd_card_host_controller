// Same pins as bench.cst, confirmed against TangPrimer-20K-example/UART/src/top.cst.
IO_LOC  "clk27" H11;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC  "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[0]" L16;  IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[1]" L14;  IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[2]" N14;  IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "led[3]" N16;  IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
