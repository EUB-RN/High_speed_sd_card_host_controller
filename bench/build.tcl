# -----------------------------------------------------------------------------
# Headless Gowin build for the BENCHMARK bitstream.
#
#   cd bench
#   QT_QPA_PLATFORM=offscreen LD_LIBRARY_PATH=$HOME/Downloads/IDE/lib \
#     ~/Downloads/IDE/bin/gw_sh build.tcl
#
# Output:  impl/gwsynthesis/  synthesis report: utilisation, warnings
#          impl/pnr/          place & route, timing report, bitstream
#
# This is the build that goes all the way to a bitstream, and therefore the one
# that produces the two reports Section 13.1 asks for:
#
#   impl/pnr/*.rpt.html / *.tr  ->  reports/gowin_timing.txt   (R-CLK-6)
#   impl/gwsynthesis/*.rpt.html ->  reports/gowin_resource.txt (Table 9-1)
#
# ../syn/build.tcl stops at synthesis on purpose: ultra_sd_top's AXI ports do not
# reach pads, so it cannot be placed on its own. The resource figure to quote is
# the one from THAT build, not this one -- this bitstream includes the benchmark,
# and the benchmark is not part of what is delivered (Section 9 budgets the core).
#
# ULTRA_SD_NO_VENDOR_PRIM IS NOT DEFINED HERE: synthesis instantiates the real
# Gowin IOBUF / DQCE / DCS / rPLL primitives. That macro is only for simulation.
# -----------------------------------------------------------------------------

set_device -name GW2A-18C GW2A-LV18PG256C8/I7

# ---- macros, first, before anything that reads them -------------------------
# ULTRA_SD_DEBUG_PORT: the init ladder's observation word. Off by default so
# rtl/'s port list is Section 5.2's and nothing else; the benchmark turns it on
# because ERR_INIT alone does not say which rung the ladder fell off.
add_file rtl/bench_defines.sv

# ---- the core, in layer order (same list as ../syn/build.tcl) ----------------
add_file ../rtl/ultra_sd_pkg.sv
add_file ../rtl/axi4/async_fifo.sv
add_file ../rtl/axi4/axi4_lite_slave.sv
add_file ../rtl/axi4/axis_rd_master.sv
add_file ../rtl/axi4/axis_wr_slave.sv
add_file ../rtl/ultra_sd_reg.sv
add_file ../rtl/axi4/ultra_sd_axi_top.sv
add_file ../rtl/ultra_sd_block.sv
add_file ../rtl/ultra_sd_cmd.sv
add_file ../rtl/ultra_sd_cmd_tx.sv
add_file ../rtl/ultra_sd_init.sv
add_file ../rtl/ultra_sd_protocol.sv
add_file ../rtl/crc/ultra_sd_crc7.sv
add_file ../rtl/crc/ultra_sd_crc16.sv
add_file ../rtl/ultra_sd_line.sv
add_file ../rtl/clk_controller.sv
add_file ../rtl/rst_sync.sv
add_file ../rtl/system_controller.sv
add_file ../rtl/ultra_sd_phy_gowin.sv
add_file ../rtl/ultra_sd_top.sv

# ---- the benchmark ----------------------------------------------------------
add_file rtl/bench_uart_tx.sv
add_file rtl/bench_lfsr.sv
add_file rtl/bench_div.sv
add_file rtl/bench_axil_master.sv
add_file rtl/bench_report.sv
add_file rtl/bench_core.sv
add_file rtl/bench_top.sv

# ---- constraints ------------------------------------------------------------
# gw_sh APPLIES EXACTLY ONE .cst. Adding two does not merge them and does not
# warn: the last one wins, the first is read as if it were not there. The first
# bring-up run was built that way, and every SD pin -- clock, command, all four
# data lines, card detect -- came out of place & route unconstrained, scattered
# over free 1.8 V pads with `Constraint = N` in section 7 of project.rpt.txt.
# The bitstream was perfectly valid and the card was not wired to it.
#
# So the two sources stay two files, because the pin map belongs in exactly one
# place and that place is constr/ultra_sd.cst, and the build concatenates them
# into the single file the tool will actually honour.
#
# AFTER ANY BUILD, CHECK THE PINOUT, DO NOT ASSUME IT. Section 7 of
# impl/pnr/project.rpt.txt lists every port with the pin it landed on and a
# Constraint column; every port in it must read Y.
set merged impl/bench_merged.cst
file mkdir impl
set out [open $merged w]
puts $out "// GENERATED by build.tcl -- do not edit. Sources, in order:"
foreach src {../constr/ultra_sd.cst constr/bench.cst} {
  puts $out "\n// ======== $src ========"
  set in [open $src r]
  puts $out [read $in]
  close $in
}
close $out

add_file $merged
add_file constr/bench.sdc

set_option -top_module bench_top
set_option -verilog_std sysv2017

# sd_dat[0] is on M8, which is also the SSPI SO/D1 configuration pin. Without
# this the placer refuses the design (pin_check/README.md step 5).
set_option -use_sspi_as_gpio 1

run all
