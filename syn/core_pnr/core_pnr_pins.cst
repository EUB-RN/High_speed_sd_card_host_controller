// ----------------------------------------------------------------------------
// core_pnr_pins.cst -- physical constraints for the CORE-ONLY place and route.
//
// This build exists to measure the core's own Fmax and its post-P&R
// utilisation, independently of the benchmark wrapper. ultra_sd_top's AXI
// ports never reach a pad in a real system, so they are deliberately left
// unplaced and the placer spreads them wherever it likes.
//
// What they are NOT left to chance on is the IO standard. Before this file
// existed the build named a sd_pins.cst that was not in the repository, so
// every pad -- the SD slot included -- came out at the default LVCMOS18 in a
// random bank, and the SD pad output delay in the timing report was a number
// from a configuration that cannot exist on this board (tINS 4.582 ns against
// 3.684 for the real LVCMOS33 DRIVE=8 pad). The pad output paths of the SD
// slot are the only place in the whole project where STA actually checks the
// interface against the card -- the benchmark build does not analyse them at
// all -- so getting their electrical model right is the difference between a
// timing report that means something and one that does not.
//
// Therefore:
//   * the seven SD slot signals are pinned exactly as constr/ultra_sd.cst
//     pins them, at LVCMOS33 DRIVE=8 PULL_MODE=NONE (Table 2-2, Table 2-3);
//   * every other port is given IO_TYPE=LVCMOS33 and nothing else, so that
//     all banks carry one VCCIO and the placer is not asked to put a 1.8 V
//     pad in a 3.3 V bank -- which is what made the first attempt fail with
//     "41 IOBUF(s) unPlaced".
//
// constr/ultra_sd.cst stays the single source of truth for the slot; if the
// two ever disagree, that one is right and this one is the bug.
// ----------------------------------------------------------------------------

// ---- SD slot: real pins, real IO standard (mirrors constr/ultra_sd.cst) ----
IO_LOC  "sd_clk"    N10;
IO_PORT "sd_clk"    IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_cmd"    R14;
IO_PORT "sd_cmd"    IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_dat[0]" M8;
IO_PORT "sd_dat[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_dat[1]" M7;
IO_PORT "sd_dat[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_dat[2]" M10;
IO_PORT "sd_dat[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_dat[3]" N11;
IO_PORT "sd_dat[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_cd"     D15;
IO_PORT "sd_cd"     IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---- everything else: bank voltage only, placement free -------------------
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_PORT "rst_n" IO_TYPE=LVCMOS33;
IO_PORT "s_axil_awaddr[0]" IO_TYPE=LVCMOS33;
